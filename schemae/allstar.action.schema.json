{
  "$id": "https://json.schemastore.org/allstar.action.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Allstar Action policy configuration",
  "type": "object",
  "definitions": {
    "OrgConfig": {
      "type": "object",
      "properties": {
        "action": {
          "description": "Which action to take. Default log; other options include issue.",
          "type": "string",
          "default": "log"
        },
        "groups": {
          "type": "array",
          "description": "Set of RuleGroups to employ during checks. Evaluated in order.",
          "items": {
            "$ref": "#/definitions/RuleGroup"
          }
        }
      },
      "required": [
        "action",
        "groups"
      ],
      "additionalProperties": false
    },
    "Rule": {
      "type": "object",
      "properties": {
        "name": {
          "description": "Name used to identify the rule",
          "type": "string"
        },
        "method": {
          "description": "Type of rule",
          "type": "string",
          "enum": [
            "require",
            "allow",
            "deny"
          ]
        },
        "priority": {
          "description": "Priority tier identifier applied to the rule",
          "type": "string",
          "enum": [
            "urgent",
            "high",
            "medium",
            "low"
          ]
        },
        "actions": {
          "type": "array",
          "description": "Actions is a set of ActionSelectors. If nil, all Actions will be selected",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "description": "Action name in glob format",
                "type": "string"
              },
              "version": {
                "description": "Semver condition or commit ref. Default empty targets any version.",
                "type": "string",
                "default": ""
              }
            },
            "additionalProperties": false
          }
        },
        "mustPass": {
          "description": "Whether the rule's actions must be part of a passing workflow on latest commit",
          "type": "boolean"
        },
        "requireAll": {
          "description": "Whether all listed actions should be required rather than just one",
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "RuleGroup": {
      "type": "object",
      "properties": {
        "name": {
          "description": "Name used to identify the RuleGroup",
          "type": "string"
        },
        "repos": {
          "type": "array",
          "description": "Set of RepoSelectors to decide whether a repo qualifies for this RuleGroup. If empty, select all repos.",
          "items": {
            "$ref": "#/definitions/RepoSelector"
          }
        },
        "rules": {
          "type": "array",
          "description": "Set of rules to apply for this RuleGroup. Rules are applied by priority. Allow and require rules are evaluated before deny rules at each priority tier.",
          "items": {
            "$ref": "#/definitions/Rule"
          }
        }
      },
      "additionalProperties": false
    },
    "RepoSelector": {
      "type": "object",
      "properties": {
        "name": {
          "description": "Repo name in glob format",
          "type": "string"
        },
        "language": {
          "type": "array",
          "description": "Set of programming languages",
          "items": {
            "type": "string"
          }
        },
        "exclude": {
          "type": "array",
          "description": "Set of RepoSelectors targeting repos that should not be matched by this selector",
          "items": {
            "$ref": "#/definitions/RepoSelector"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "anyOf": [
    {
      "$ref": "#/definitions/OrgConfig"
    }
  ]
}
