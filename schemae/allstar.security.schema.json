{
  "$id": "https://json.schemastore.org/allstar.security.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Allstar SECURITY.md policy configuration",
  "type": "object",
  "definitions": {
    "OrgConfig": {
      "type": "object",
      "properties": {
        "optConfig": {
          "type": "object",
          "description": "Standard org-level opt-in or opt-out configuration. RepoOverride applies to all configuration."
        },
        "action": {
          "description": "Which action to take. Default log; other options include issue.",
          "type": "string",
          "default": "log"
        }
      },
      "required": [
        "optConfig",
        "action"
      ],
      "additionalProperties": false
    },
    "RepoConfig": {
      "type": "object",
      "properties": {
        "optConfig": {
          "type": "object",
          "description": "Standard repo-level opt-in or opt-out configuration."
        },
        "action": {
          "description": "Override for org-level action when present",
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "anyOf": [
    {
      "$ref": "#/definitions/OrgConfig"
    },
    {
      "$ref": "#/definitions/RepoConfig"
    }
  ]
}
