{
  "$id": "https://json.schemastore.org/allstar.outside.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Allstar Outside Collaborators policy configuration",
  "type": "object",
  "definitions": {
    "OutsideExemption": {
      "type": "object",
      "properties": {
        "user": {
          "description": "GitHub username",
          "type": "string"
        },
        "repo": {
          "description": "GitHub repository name",
          "type": "string"
        },
        "push": {
          "description": "Allow push permission",
          "type": "boolean"
        },
        "admin": {
          "description": "Allow admin permission",
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "OrgConfig": {
      "type": "object",
      "properties": {
        "optConfig": {
          "type": "object",
          "description": "Standard org-level opt-in or opt-out configuration. RepoOverride applies to all configuration."
        },
        "action": {
          "description": "Which action to take. Default log; other options include issue.",
          "type": "string",
          "default": "log"
        },
        "pushAllowed": {
          "description": "Whether outside collaborators are allowed to have push access",
          "type": "boolean",
          "default": true
        },
        "adminAllowed": {
          "description": "Whether outside collaborators are allowed to have admin access",
          "type": "boolean",
          "default": false
        },
        "exemptions": {
          "type": "array",
          "description": "List of user-repo-access exemption entries. Only defined at org level.",
          "items": {
            "$ref": "#/definitions/OutsideExemption"
          }
        }
      },
      "required": [
        "optConfig",
        "action"
      ],
      "additionalProperties": false
    },
    "RepoConfig": {
      "type": "object",
      "properties": {
        "optConfig": {
          "type": "object",
          "description": "Standard repo-level opt-in or opt-out configuration."
        },
        "action": {
          "description": "Override for org-level action when present",
          "type": "string"
        },
        "pushAllowed": {
          "description": "Override for org-level pushAllowed when present",
          "type": "boolean"
        },
        "adminAllowed": {
          "description": "Override for org-level adminAllowed when present",
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  },
  "anyOf": [
    {
      "$ref": "#/definitions/OrgConfig"
    },
    {
      "$ref": "#/definitions/RepoConfig"
    }
  ]
}
